<?xml version="1.0" encoding="utf-8"?>
<!-- Сессия и демо-аккаунты исключены из резервных копий и прямого переноса. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
        <exclude domain="sharedpref" path="auth_demo_accounts.xml" />
        <exclude domain="sharedpref" path="profile_demo_server.xml" />
        <exclude domain="sharedpref" path="collections_demo_server.xml" />
        <exclude domain="sharedpref" path="book_demo_server.xml" />
        <exclude domain="sharedpref" path="book_rating_mock_cache.xml" />
        <exclude domain="sharedpref" path="library_demo_server.xml" />
        <exclude domain="sharedpref" path="library_search_history.xml" />
        <exclude domain="file" path="demo_avatars/" />
        <exclude domain="file" path="demo_collection_covers/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
        <exclude domain="sharedpref" path="auth_demo_accounts.xml" />
        <exclude domain="sharedpref" path="profile_demo_server.xml" />
        <exclude domain="sharedpref" path="collections_demo_server.xml" />
        <exclude domain="sharedpref" path="book_demo_server.xml" />
        <exclude domain="sharedpref" path="book_rating_mock_cache.xml" />
        <exclude domain="sharedpref" path="library_demo_server.xml" />
        <exclude domain="sharedpref" path="library_search_history.xml" />
        <exclude domain="file" path="demo_avatars/" />
        <exclude domain="file" path="demo_collection_covers/" />
    </device-transfer>
</data-extraction-rules>
